[Unit]
Description=WorkPay Calculator Flask Application
After=network.target

[Service]
Type=simple
User=workpay
Group=workpay
WorkingDirectory=/srv/workpay/src
EnvironmentFile=/etc/workpay.conf
Environment="PATH=/srv/workpay/.venv/bin"
Environment="WORKPAY_DATA_DIR=/var/lib/workpay"
ExecStart=/srv/workpay/.venv/bin/python -m flask run --host=0.0.0.0 --port=8888

# 자동 재시작 설정
Restart=always
RestartSec=10

# 로그 설정
StandardOutput=journal
StandardError=journal
SyslogIdentifier=workpay-calculator

# 보안 설정
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
